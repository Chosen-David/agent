{
  "schema_version": 1,
  "validation_scope": {
    "kind": "normative_offline_taskset",
    "runs_model": false,
    "runs_production_router": false,
    "renders_figures": false,
    "proves_aesthetic_quality": false,
    "proves_tool_integration": false,
    "fixture_preservation_only": true,
    "description": "Static packaging and normative review contracts, plus synthetic numeric/semantic preservation examples. Passing is not evidence of live routing, model compliance, aesthetics or publishing quality."
  },
  "acceptance": {
    "requires_actual_render_inspection": true,
    "script_success_is_sufficient": false,
    "unknown_or_unchecked_can_pass": false,
    "unresolved_status": "draft"
  },
  "qa_rubric": {
    "final_size": {
      "pass_criteria": [
        "整图与各 panel 在目标物理尺寸下可读。",
        "检查轴、图例、符号、线宽、箭头、有效分辨率及裁切。"
      ],
      "required_evidence": [
        "实际尺寸的已渲染预览及观察记录。"
      ],
      "failure_examples": [
        "仅查看大幅放大预览。",
        "以导出脚本成功代替读图。"
      ]
    },
    "palette": {
      "pass_criteria": [
        "颜色语义与类别/连续量/中点偏差相匹配。",
        "同一对象跨 panel 身份一致，指定配色无未经授权变更。"
      ],
      "required_evidence": [
        "对象到颜色/形状/线型映射，色标范围和实际渲染。"
      ],
      "failure_examples": [
        "相同颜色表达不同对象而无解释。",
        "彩虹色标制造不存在的边界。"
      ]
    },
    "typography": {
      "pass_criteria": [
        "字号层级一致，正文/数学符号/上下标在最终尺寸可读。",
        "字体完整，标签准确。"
      ],
      "required_evidence": [
        "实际尺寸预览、字体与导出检查。"
      ],
      "failure_examples": [
        "靠缩小字体塞入所有信息。",
        "符号缺字或字体替换未检查。"
      ]
    },
    "whitespace": {
      "pass_criteria": [
        "阅读顺序清晰，对齐、间距、图例位置和面板密度均有目的。",
        "避免过度拥挤，也避免无信息的大空区。"
      ],
      "required_evidence": [
        "完整布局渲染及发现问题后的修订记录。"
      ],
      "failure_examples": [
        "连线穿过文字。",
        "装饰挤压内容，标签碰撞。"
      ]
    },
    "accessibility": {
      "pass_criteria": [
        "重要区别不只依赖颜色，适用时用线型、形状或文字。",
        "检查色觉缺陷、灰度和对比度表现。"
      ],
      "required_evidence": [
        "最终渲染的色觉/灰度检查和区别仍可辨的说明。"
      ],
      "failure_examples": [
        "红绿两条重叠曲线只能靠颜色分辨。",
        "浅文字在背景上不可读。"
      ]
    },
    "evidence_preservation": {
      "pass_criteria": [
        "数值、单位、统计定义、理论前提、关系语义和证据性质保持可追溯。",
        "保留可编辑主源、输入定位/版本、处理与导出步骤；精修差异可解释。"
      ],
      "required_evidence": [
        "原始来源与前后受保护字段核验；适用时复算关键值或比对节点/边。"
      ],
      "failure_examples": [
        "截图估读当原始值。",
        "美化反转因果边。",
        "生成图替代研究证据。",
        "缺素材的占位 panel 被标为已完成。"
      ]
    }
  },
  "cases": [
