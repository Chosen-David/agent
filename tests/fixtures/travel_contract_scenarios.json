  "fixture_mapping": {
    "general": "Cases are intentionally partial records, not valid complete local-travel/v1 bundles. Wrapper keys such as expected describe the test, not the production contract.",
    "exact_entity": "Candidates and selection_plan use canonical IDs; itinerary also includes a rendered navigable_address projection to test exact branch/address preservation in output.",
    "rest": "waiver/rest_adjustment are synthetic explicit-user-decision evidence. They illustrate an authorized amendment of request_contract.trip_brief.rest_preferences, not extra canonical fields.",
    "budget": "Each line is one price record; quantity is actual people for per_person or vehicle count for per_car. Separate outward/return lines preserve that billing scope; no second multiplication by people occurs.",
    "amendment": "Artifacts combine an earlier COMPLETED stage status with output validity. An amendment changes validity without rewriting historical completion. The changed node itself represents freshly updated input, and only its downstream consumers are invalidated here.",
    "resume": "Each node combines a stage status and one output for a reduced graph. revision is that synthetic output version, validated_for_revision is the bundle revision it was checked against, and dependencies maps node IDs to recorded output versions. This is not a runtime state schema.",
    "artifact": "Each dependency includes its recorded and actual synthetic output version. These stand in for checked depends_on references; qa denotes the documented QA state.",
    "service_windows": "Examples test explicit same-window duration, last_admission and last_order. Exit buffers are assumed zero in these reduced examples; actual plans also include queue, transport and exit buffers."
  }
}
