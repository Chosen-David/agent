{
  "schema_version": "task-dag/v1",
  "run_id": "replace-with-private-run-id",
  "user_goal": "Verify the explicitly authorized task artifact",
  "authorization_reference": "replace-with-current-user-instruction-reference",
  "supervision": {
    "min_seconds": 30,
    "max_seconds": 3600,
    "rationale": "Host AI estimate: local artifact expected in two minutes; low risk; back off when unchanged"
  },
  "tasks": [
    {
      "task_id": "verify-output",
      "owner": "main-ai",
      "inputs": {},
      "depends_on": [],
      "action": "verify_artifacts",
      "estimated_seconds": 120,
      "risk": "low",
      "max_attempts": 10,
      "wait_policy": {"max_polls": 120, "max_seconds": 3600, "diagnose_after_seconds": 300},
      "outputs": ["result.txt"],
      "done_when": {
        "artifacts": [{"path": "result.txt", "sha256": "replace-with-predeclared-expected-digest"}]
      }
    }
  ]
}
