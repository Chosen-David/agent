  "id": "math.topk-margin",
  "version": 1,
  "status": "published",
  "kind": "theorem",
  "title": "有界分数误差下的 Top-k 稳定性",
  "summary": "用边界分数间隔判断近似排序能否保留 Top-k 集合。",
  "aliases": [
    "排序会不会变",
    "ranking stability",
    "top-k",
    "候选筛选",
    "近似分数",
    "间隔"
  ],
  "domains": [
    "linear-algebra",
    "optimization"
  ],
  "structures": [
    "ranking",
    "error-bound"
  ],
  "assumptions": [
    "有限 n 个实分数，1≤k<n，原分数降序排列",
    "每个分数均满足绝对误差≤ε，而不是仅平均误差",
    "边界间隔 Δ=s_(k)−s_(k+1) 严格大于 2ε"
  ],
  "sources": [
    {
      "url": "https://people.math.wisc.edu/~gemeyer/math340/Notes3.html",
      "locator": "Theorem 5.3 仅支持内积误差上界；Top-k 命题为本条显式推导",
      "accessed": "2026-10-06"
    }
  ],
