  "structures": [
    "discrete-linear-dynamics",
    "quadratic-energy-certificate",
    "nonnormal-transient",
    "switched-system-boundary"
  ],
  "assumptions": [
    "固定有限维实A，整数时间完整状态x_next=Ax；Schur稳定要求ρ(A)<1",
