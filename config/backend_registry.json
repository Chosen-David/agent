      "detect": {
        "python_modules": [
          "paperqa"
        ],
        "commands": [
          "pqa"
        ]
      },
      "notes": "Use retrieval results as evidence candidates; preserve source/page anchors and re-check claims before writing."
    },
    {
      "id": "storm",
      "name": "STORM / Co-STORM",
      "repo": "https://github.com/stanford-oval/storm",
