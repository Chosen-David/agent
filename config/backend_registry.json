{
  "schema_version": 1,
  "updated_at": "2026-10-01",
  "policy": {
    "principle": "Keep Chosen-David/agent as the goal/workflow/evidence layer; reuse specialist backends only for capabilities they demonstrably implement better.",
    "selection_order": [
      "native_capability",
      "specialist_backend",
      "pattern_or_skill",
      "runtime_adapter",
      "bounded_fallback"
    ],
    "rules": [
      "Do not install a backend merely because it exists in this registry.",
      "Check the current upstream README/release/license before first adoption in a project.",
      "Pin the validated release or commit for repeated use in one project.",
      "Return backend output through the shared handoff contract; external agents do not own project truth.",
      "User constraints, permissions, evidence standards and final acceptance remain controlled by this repository."
    ]
  },
  "backends": [
    {
      "id": "gpt-researcher",
      "name": "GPT Researcher",
      "repo": "https://github.com/assafelovic/gpt-researcher",
      "category": "web_research",
      "adoption": "prefer_when_available",
      "use_when": [
        "broad public-web deep research",
        "multi-source fact gathering",
        "long cited research reports"
      ],
      "avoid_when": [
        "scientific hypothesis validation without experiments",
        "private corpus that must not leave the environment"
      ],
      "strengths": [
        "planner/execution/publisher pipeline",
        "multi-source retrieval",
        "MCP support",
        "report export"
      ],
      "handoff_to": [
        "research-explore",
        "research-write"
      ],
      "detect": {
        "python_modules": [
          "gpt_researcher"
        ],
        "commands": []
      },
      "notes": "Use as information-research backend; research judgment and experiment design stay in this repo."
    },
    {
      "id": "paperqa2",
      "name": "PaperQA2",
      "repo": "https://github.com/Future-House/paper-qa",
      "category": "scientific_rag",
      "adoption": "prefer_when_available",
      "use_when": [
        "multi-paper or local scientific corpus QA",
        "literature evidence retrieval",
        "citation-aware synthesis",
        "contradiction search"
      ],
      "avoid_when": [
        "final PDF visual QA",
        "single-page visual explanation where direct page inspection is enough"
      ],
      "strengths": [
        "scientific literature RAG",
        "agentic evidence gathering",
        "metadata-aware reranking",
        "local index reuse"
      ],
      "handoff_to": [
        "research-explore",
        "paper-reading-companion",
        "research-review",
        "research-write"
